# Studio Configuration & Secrets Template
# Copy this file to .env and fill in any custom values.
# NOTE: .env is strictly ignored by Git and will never be committed.

# Server Configuration
PORT=3001
HOST=0.0.0.0

# Security & CORS Configuration
# Set to your production domain (e.g., https://studio.example.com) or '*' for local LAN
ALLOWED_ORIGIN=*
MAX_PAYLOAD_MB=10

# Optional API Keys / Third-party services
# (Server-side keys without VITE_ prefix are never bundled into client JS)
# STUDIO_API_SECRET=your_secret_key_here

# Initial admin (Boss) password. Required: admin login is disabled if empty.
# Can be changed later from Settings inside the app.
VITE_ADMIN_PASSWORD=
